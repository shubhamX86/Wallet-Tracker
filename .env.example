# Copy to .env — never commit .env
ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_USER=whale
POSTGRES_PASSWORD=whale
POSTGRES_DB=whale

# Used when running the backend outside Docker (compose overrides these)
DATABASE_URL=postgresql+psycopg://whale:whale@localhost:5432/whale
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:3000,http://localhost

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (32+ chars) whenever ENVIRONMENT is not "development".
JWT_SECRET=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_RATE_LIMIT_PER_MINUTE=10

# Blockchain RPC (read-only). URLs are server-side config only. Keyed providers may embed an
# API key in the URL — keep it in .env, never commit it.
RPC_TIMEOUT_SECONDS=10
RPC_MAX_RETRIES=2
BNB_RPC_URL=https://bsc-dataseed.bnbchain.org

# Used by `next dev` to proxy /api (Docker sets this itself)
BACKEND_INTERNAL_URL=http://localhost:8000
